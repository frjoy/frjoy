{
  "name": "@frjoy/otp",
  "version": "0.2.2",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "targets": {
    "main": {
      "includeNodeModules": [
        "@frjoy/otp-core"
      ]
    },
    "module": {
      "includeNodeModules": [
        "@frjoy/otp-core"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf dist && rm -rf node_modules && find . -type d -name '__snapshots__' -exec rm -rf {} +",
    "version": "pnpm version"
  },
  "keywords": [
    "otp",
    "react",
    "typescript",
    "frjoy"
  ],
  "author": "Felix Dusengimana <info@feldux.com>",
  "license": "MIT",
  "devDependencies": {
    "@frjoy/otp-core": "workspace:*"
  },
  "peerDependencies": {
    "@types/react": "*",
    "@types/react-dom": "*",
    "react": "^18.0 || ^19.0",
    "react-dom": "^18.0 || ^19.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frjoy/frjoy.git",
    "directory": "packages/otp"
  }
}
